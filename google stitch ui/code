        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 2500);
    }

    function handleCopyMarkdown() {
      navigator.clipboard.writeText(markdownRaw).then(() => {
        showToast('README.md copied to clipboard');
      }).catch(() => {
        showToast('Copied to clipboard');
      });
    }

    function copySnippet(text) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('Command copied to clipboard');
      });
    }

    function handleDownloadReadme() {
      const blob = new Blob([markdownRaw], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'README.md';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast('Downloading README.md');
    }
